# Required. From @BotFather.
BOT_TOKEN=

# Required. Numeric chat id (recommended, looks like -1001234567890) or @channel.
# The numeric id keeps working even if the channel username changes later.
CHANNEL_CHAT_ID=

# Optional. The channel's public link, shown by /start in DM.
# If unset, the bot derives it from an @username channel id when possible.
CHANNEL_PUBLIC_URL=

# Optional. Your Telegram user id (numeric). Unlocks /admin_* commands.
ADMIN_TELEGRAM_ID=

# Optional. Cron timezone for the schedules. Defaults to Africa/Cairo.
# Examples: Africa/Cairo, Europe/London, America/New_York, Asia/Riyadh.
TZ_NAME=Africa/Cairo

# Optional. production for hosted, anything else (or unset) is dev.
NODE_ENV=

# Optional. Port for the /health HTTP endpoint. Defaults to 8080.
PORT=

# Optional. When the daily set posts (standard 5-field crontab format).
# Default is 18:00 (6pm) in TZ_NAME, the evening sweet spot for educational
# channels. The whole set posts together: three quizzes (A1-A2, B1-B2, C1-C2),
# a grammar point, a "say it like a native" phrase, a role-play dialogue, then an
# audio shadowing clip. Every post but the last is sent silently, so followers
# get a single daily ping but still receive everything.
DAILY_CRON=

# Optional. When the per-user practice reminder fires (personal tutor only),
# in TZ_NAME. Default 09:00, a morning nudge separate from the evening drop.
REMINDER_CRON=

# Optional. Turns on the personal tutor (the /next, /level, /streak DM commands)
# and stores per-user progress in the shared MariaDB. Leave it UNSET and the bot
# is a stateless channel broadcaster with no database, exactly as before.
# The host is the docker service name (shared-db), not localhost. The bot creates
# its tables automatically on first boot, so there is no migration step to run.
# DATABASE_URL="mysql://fluentowls:<password>@shared-db:3306/fluentowls_db"
DATABASE_URL=

# --- Audio generation (DEV ONLY) -------------------------------------------
# These are used ONLY by `pnpm generate-audio`, which creates the shadowing
# voice clips once and commits them as .ogg files. The running bot never reads
# them: it only posts the committed audio, so production needs no TTS key, has
# no TTS cost, and no extra failure mode. Leave these blank in production.

# Required only to RUN generate-audio. Your ElevenLabs API key.
ELEVENLABS_API_KEY=

# Optional. One ElevenLabs voice per CEFR level for the shadowing audio. If a
# level is left blank, a curated American voice is used (see scripts/generate-audio.ts).
# To change one, open ElevenLabs -> Voices, preview a voice, copy its Voice ID
# (the "..." menu -> Copy Voice ID), and paste it here.
ELEVENLABS_VOICE_A1=
ELEVENLABS_VOICE_A2=
ELEVENLABS_VOICE_B1=
ELEVENLABS_VOICE_B2=
ELEVENLABS_VOICE_C1=
ELEVENLABS_VOICE_C2=

# Optional. Force a SINGLE voice for every clip, ignoring the per-level vars above.
ELEVENLABS_VOICE_ID=

# Optional. ElevenLabs model. Defaults to eleven_multilingual_v2 (best prosody).
ELEVENLABS_MODEL_ID=
