// Prisma schema for the optional personal tutor. Matches the fleet convention
// (the tilawah bot): the `prisma-client` generator emits an ESM client into
// src/database/generated (gitignored, regenerated by `prisma generate`), and the
// connection URL is supplied at runtime via the driver adapter, not here.
//
// TS model names are PascalCase singular and fields camelCase; @map / @@map
// expose snake_case table and column names in MySQL.

generator client {
  provider = "prisma-client"
  output   = "../src/database/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// One row per learner who uses the personal tutor (/next, /level, /streak).
model Learner {
  // The learner's Telegram user id (fits in a JS number, but BigInt is safe).
  telegramId BigInt   @id @map("telegram_id")
  // CEFR level used by /next, e.g. "b1".
  level      String   @default("b1") @db.VarChar(2)
  // Round-robin position across the kinds, advanced on every /next.
  step       Int      @default(0)
  // JSON map of kind -> position (the per-kind sequence cursor).
  cursors    String?  @db.Text
  // Consecutive-day practice streak.
  streak     Int      @default(0)
  // The last calendar day the learner practised, "YYYY-MM-DD" in TZ_NAME.
  lastDay    String?  @map("last_day") @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("learners")
}
